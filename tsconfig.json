{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
	"paths": {
	  "*": ["./src/*"]
	},
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "ES2022",
    "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts"]
}
